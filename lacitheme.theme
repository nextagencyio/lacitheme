}

/**
 * Implements template_preprocess_page.
 *
 * Add convenience variables and template suggestions.
 */

function lacitheme_preprocess_page(&$variables) {
  if (empty($variables['laci_login_image_url'])) {
    $variables['laci_login_image_url'] = \Drupal::service('file_url_generator')->generate(\Drupal::service('extension.list.theme')->getPath('lacitheme').'/images/img-login-left.png');
  }
}


