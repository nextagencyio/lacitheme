/**
 * Implements template_preprocess_html().
 *
 * Adds additional classes.
 */
function lacitheme_preprocess_menu(&$variables) {
  $variables['theme_logo_url'] = \Drupal::service('file_url_generator')->generate(\Drupal::service('extension.list.theme')->getPath('lacitheme').'/logo.png');
}

/**
 * Implements template_preprocess_node.
